# Database — use docker-compose for local dev, or your own PostgreSQL URL
DATABASE_URL="postgresql://sifos:sifos@localhost:5432/sifos?schema=public"

# JWT (use a long random string in production)
JWT_SECRET="change-this-to-a-long-random-secret-before-deploying"
JWT_EXPIRES_IN="24h"

# Server
PORT=3001
NODE_ENV=production
CLIENT_URL=http://localhost:5173

# Demo Mode — keeps live simulator + demo123 login fallback
DEMO_MODE=true
